module sh.sysl.lapack

import sh.sysl.blas.MatrixView
import sysl.math.max

// The matrix every function here takes and answers is `blas`'s `MatrixView[T]`: column-major,
// element (i, j) at `data[i + j * ld]`, made over a slice (`MatrixView.of`, `MatrixView.strided`) or
// over storage C or an interpreter owns (`MatrixView.from_ptr`), with nothing copied. A view made from
// a slice keeps its backing alive, which is how the fresh storage a function here answers stays valid.

/** A fresh m × n matrix of zeros, dense (`ld == max(rows, 1)`). */
zeros[T: Zero](rows: usize, cols: usize) -> MatrixView[T] = MatrixView([T.zero(); rows * cols], rows, cols, max(rows, 1))

/** A dense copy of `a`, which LAPACK may overwrite: the value forms never write their arguments. */
private[lapack] dense[T: Zero](a: MatrixView[T]) -> MatrixView[T]
    val out: MatrixView[T] = zeros(a.rows, a.cols)

    for j in 0..<a.cols
        for i in 0..<a.rows do out.set(i, j, a.at(i, j))

    out
