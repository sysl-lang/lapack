// LAPACK — dense linear algebra: solving, least squares, LU, Cholesky, QR, eigenvalues, the SVD —
// bound for sysl through its Fortran interface.
//
// This is the block a consumer writes to reach it:
//
//     dependencies {
//       lapack { git = "github.com/sysl-lang/lapack", version = "0.1.1" }
//     }
//
// The coordinate names the package, `lapack`; the module a program imports is `sh.sysl.lapack`.

package {
  name    = "lapack"
  version = "0.1.1"

  // The compiler this was written and tested against.
  sysl = "0.8.2"
}

// **`heap`**: every answer is fresh storage, and every workspace LAPACK asks for is allocated.
// **`posix`**: LAPACK is a hosted library — Accelerate or OpenBLAS, each with threads under it.
requires {
  heap  = true
  posix = true
}

// **`blas` supplies the matrix view and the element types**: `MatrixView[T]` is the one column-major
// view both packages read, and `Element` is the trait `Scalar` extends.
dependencies {
  blas { git = "github.com/sysl-lang/blas", version = "0.1.0" }
}

// **Which LAPACK answers is chosen as `blas` chooses its BLAS, by the same two features, and each
// passes itself on to `blas`** — so one build never pairs Accelerate's LAPACK with OpenBLAS's BLAS.
// `platform` is Accelerate's LAPACK on macOS (`-llapack`, the SDK's `liblapack.tbd`) and OpenBLAS
// elsewhere; `openblas` is OpenBLAS everywhere, found through `blas`'s `openblas.pc` requirement
// (`PKG_CONFIG_PATH=/opt/homebrew/opt/openblas/lib/pkgconfig` on macOS, where it is keg-only).
features {
  platform {
    doc     = "the platform's LAPACK: Accelerate on macOS, OpenBLAS (-lopenblas) elsewhere"
    enables = ["blas/platform"]
  }

  openblas {
    doc     = "OpenBLAS's LAPACK — on macOS in place of Accelerate"
    enables = ["blas/openblas"]
  }
}

choices {
  library { doc = "which LAPACK answers the calls", of = [platform, openblas], default = platform }
}

// `sysl test .` checks the default library — Accelerate on macOS. `sysl test . --features openblas`
// runs the same suite against OpenBLAS.
test {
  features = [platform]
}
