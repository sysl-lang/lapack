// LAPACK — dense linear algebra: solving, least squares, LU, Cholesky, QR, eigenvalues, the SVD —
// bound for sysl through its Fortran interface.
//
// This is the block a consumer writes to reach it:
//
//     dependencies {
//       lapack { git = "github.com/sysl-lang/lapack", version = "0.1.0" }
//     }
//
// The coordinate names the package, `lapack`; the module a program imports is `sh.sysl.lapack`.

package {
  name    = "lapack"
  version = "0.1.0"

  // The compiler this was written and tested against.
  sysl = "0.8.2"
}

// **`heap`**: every answer is fresh storage, and every workspace LAPACK asks for is allocated.
// **`posix`**: LAPACK is a hosted library — Accelerate or OpenBLAS, each with threads under it.
//
// **No `pkg_config`.** The library is named by `@link("lapack")` in `c/c.sysl` and found by the
// linker: Accelerate's `liblapack.tbd` in the macOS SDK, or the directory `--link-path` names
// (`/opt/homebrew/opt/openblas/lib` for Homebrew's OpenBLAS), or the distribution's `liblapack` on
// Linux. Accelerate ships no `.pc` at all, so a probe would refuse the one library every Mac has.
requires {
  heap  = true
  posix = true
}
